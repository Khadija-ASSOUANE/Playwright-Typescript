# ─── Application URLs ────────────────────────────────────────────────────────
GOOGLE_URL=https://www.google.com
BASE_URL=https://opensource-demo.orangehrmlive.com
CSH_APPID=your-customer-service-hub-app-id
ORANGEHRM_URL=https://opensource-demo.orangehrmlive.com
BASE_API_URL=https://restful-booker.herokuapp.com

# ─── Test Credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# ─── Test Execution ───────────────────────────────────────────────────────────
TEST_EXECUTION_ENV=qa
ENV=qa
SEARCH_KEYWORDS=Playwright

# ─── Azure DevOps Integration ────────────────────────────────────────────────
AZURE_DEVOPS_USER=your-azure-devops-username
AZURE_DEVOPS_PASS=your-azure-devops-pat-token

TEST_PLAN_ID=your-test-plan-id
TEST_SUITE_ID=your-test-suite-id

# Format: https://dev.azure.com/{org}/{project}/_apis/testplan/Plans/{0}/Suites/{1}/TestPoint?testCaseId={2}&api-version=7.0
TEST_PLAN_GET_API=https://dev.azure.com/your-org/your-project/_apis/testplan/Plans/{0}/Suites/{1}/TestPoint?testCaseId={2}&api-version=7.0

# Format: https://dev.azure.com/{org}/{project}/_apis/testplan/Plans/{0}/Suites/{1}/TestPoint/{2}?api-version=7.0
TEST_PLAN_PATCH_API=https://dev.azure.com/your-org/your-project/_apis/testplan/Plans/{0}/Suites/{1}/TestPoint/{2}?api-version=7.0

# ─── Pipeline Control ────────────────────────────────────────────────────────
UPDATE_TEST_PLAN=No
PIPELINE=No
CI=
